{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Co-Pa",
  "mainBinaryName": "linux-clipboard-manager",
  "version": "0.1.0",
  "identifier": "io.github.yannkost.ClipboardManager",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "popup",
        "title": "Co-Pa",
        "width": 624,
        "height": 708,
        "resizable": false,
        "decorations": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Utility",
    "shortDescription": "Clipboard history manager",
    "longDescription": "A Ditto-style clipboard history manager for GNOME on Wayland: text and image history, search, pinning, preview and auto-paste.",
    "publisher": "Yann Kost",
    "homepage": "https://github.com/yannkost/linux-clipboard-manager",
    "linux": {
      "deb": {
        "section": "utils"
      }
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"]
  }
}
